# Copy to .env. Never commit this file.

GROQ_API_KEY=your_groq_key_here
FORTYGUARD_API_KEY=your_fortyguard_key_here

# MongoDB - use MongoDB Atlas free tier (mongodb.com/atlas), or a local
# mongod instance for development.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/thermalguard

# Used to sign login tokens. Generate any long random string, e.g. via:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Twilio (free trial account works for a demo)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
EMERGENCY_CONTACT_NUMBER=+1xxxxxxxxxx

PORT=3000
FRONTEND_ORIGIN=http://localhost:3001
